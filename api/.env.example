# Server Configuration
PORT=3001
NODE_ENV=development

APP_URL=<your-app-url>
CORS_ALLOWED_ORIGINS=https://dev.scholarshipmanage.pages.dev,http://localhost:5173
# Production only: set to 1 when deployed behind Railway or another single trusted proxy.
TRUST_PROXY=1

# Optional in local development. Set on Railway or other multi-instance deployments
# to share rate-limit counters across API instances.
REDIS_URL=
# Only set true for an intentional single-instance deployment without Redis.
ALLOW_IN_MEMORY_RATE_LIMIT=false

# Development/local rate-limit defaults. These are the same fallback values used
# by api/src/config/rate-limit.ts when no RATE_LIMIT_* env vars are set.
RATE_LIMIT_AUTH_LOGIN=5
RATE_LIMIT_AUTH_REGISTER=30
RATE_LIMIT_AUTH_PASSWORD_RESET=3
RATE_LIMIT_AUTH_EMAIL_VERIFY=5
RATE_LIMIT_WRITE_OPERATIONS=30
RATE_LIMIT_DELETE_OPERATIONS=60
RATE_LIMIT_READ_OPERATIONS=100
RATE_LIMIT_LIST_OPERATIONS=50
RATE_LIMIT_GENERAL_API=150
RATE_LIMIT_PUBLIC_ENDPOINTS=60
RATE_LIMIT_WEBHOOK=100

# Production/Railway recommended rate-limit settings. Add these as Railway
# production environment variables instead of using the development values above.
# RATE_LIMIT_AUTH_LOGIN=20
# RATE_LIMIT_AUTH_REGISTER=30
# RATE_LIMIT_AUTH_PASSWORD_RESET=10
# RATE_LIMIT_AUTH_EMAIL_VERIFY=20
# RATE_LIMIT_WRITE_OPERATIONS=120
# RATE_LIMIT_DELETE_OPERATIONS=60
# RATE_LIMIT_READ_OPERATIONS=300
# RATE_LIMIT_LIST_OPERATIONS=200
# RATE_LIMIT_GENERAL_API=500
# RATE_LIMIT_PUBLIC_ENDPOINTS=120
# RATE_LIMIT_WEBHOOK=100

# Supabase Configuration
# Get these values from your Supabase project dashboard
# Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: Use the SERVICE ROLE KEY for the backend (server-side)
# This key bypasses Row Level Security (RLS) so handle with care

# Resend Email Service Configuration
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=<send-from-email>
RESEND_WEBHOOK_SECRET=<resend-webhook-secret>
RESEND_FROM_EMAIL=noreply@yourCompany.com
RESEND_FROM_NAME=Yourname

# Cron Job Authentication
# Secret token for protecting cron endpoints (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -hex 32
CRON_SECRET=your-secure-random-secret-here
